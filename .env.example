# =====================================================================
# MEMO-EXIP: Configuration Environment Variables
# Copy this file to .env and provide your local credentials.
# NEVER commit the actual .env file with secrets to version control.
# =====================================================================

# LLM Provider Configuration
LLM_PROVIDER=mock                     # Options: "mock", "groq"
GROQ_API_KEY=your_groq_api_key_here    # Required only if LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile    # Recommended default Groq model

# Storage Configuration
SQLITE_DB_PATH=data/temporal_memory.db
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Memory & Retrieval Hyperparameters
DEFAULT_CONTEXT_TOKEN_BUDGET=1024
DEFAULT_SIMILARITY_TOP_K=5
REDUNDANCY_SIMILARITY_THRESHOLD=0.85

# Server & UI Ports
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
